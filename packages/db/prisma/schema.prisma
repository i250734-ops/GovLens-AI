datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}
model User {
  id              String   @id @default(uuid())
  email           String   @unique
  createdAt       DateTime @default(now())
  naicsCodes      String[]
  setAsideStatus  String?
  keywords        String[]
}
model Opportunity {
  summary       OpportunitySummary?
  id          String    @id @default(uuid())
  samGovId    String    @unique
  title       String
  naicsCode   String
  setAside    String?
  agency      String?
  description String?
  postedDate  DateTime?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
}
// Models added when the schema is designed (opportunities, users, matches, etc.)

model OpportunitySummary {
  id             String   @id @default(uuid())
  opportunityId  String   @unique
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id])
  deadline       String?
  scope          String?
  eligibility    String?
  plainExplanation String?
  createdAt      DateTime @default(now())
}
