# Copy to .env.local (web) / .env (worker) and fill in real values.
# Never commit the filled-in version.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Prisma - Supabase Postgres connection string)
# DATABASE_URL: pooled connection (port 6543, transaction mode) - used by the Prisma Client at runtime
# DIRECT_URL: direct connection (port 5432) - used only by the Prisma Migrate engine, which doesn't support PgBouncer pooling
DATABASE_URL=
DIRECT_URL=

# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# SAM.gov API (free — register at https://sam.gov/data-services)
SAM_GOV_API_KEY=

# Paddle (Merchant of Record — NOT Stripe)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
# PADDLE_ENV=production   # switch when ready to go live

# Email
RESEND_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
